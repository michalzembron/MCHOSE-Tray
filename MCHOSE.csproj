<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>MchoseTray</AssemblyName>
        <ApplicationIcon>assets\app.ico</ApplicationIcon>

        <Version>1.0.0</Version>
        <Product>MCHOSE Tray</Product>
        <Description>Unofficial tray app for MCHOSE mice: battery level and mouse settings</Description>
        <Authors>Michał Zembroń</Authors>
        <Copyright>Copyright © 2026 Michał Zembroń</Copyright>
        <RepositoryUrl>https://github.com/michalzembron/MCHOSE-Tray</RepositoryUrl>
        <!-- Don't embed the local build path or git metadata noise in the binary -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Deterministic>true</Deterministic>
        <!-- ThemeMode (Fluent theme) is still marked as an experimental API -->
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
        <!-- The project sits in the repo root - don't pull in the library and tool sources -->
        <DefaultItemExcludes>$(DefaultItemExcludes);MCHOSE.Protocol\**;tools\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    </ItemGroup>

    <ItemGroup>
      <!-- Window icon (the .exe icon comes from ApplicationIcon) -->
      <Resource Include="assets\app.ico" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="MCHOSE.Protocol\MCHOSE.Protocol.csproj" />
    </ItemGroup>

</Project>
